OMNIROUTE_BASE_URL=http://192.168.15.112:20128/v1
# Deixe vazio se a instância local não exigir autenticação.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/coding:free
# Rota separada e gratuita validada para entrada de imagem na Fase 7A.
OMNIROUTE_VISION_MODEL=oc/mimo-v2.5-free
# Fallback visual gratuito; acionado somente em rate limit/timeout do principal.
OMNIROUTE_VISION_FALLBACK_MODEL=openai-compatible-chat-38d59294-9537-4ebf-a7bd-c8853db07903/google/gemma-4-31b-it:free
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=2
SEARCH_PROVIDER=searxng-search
SEARCH_CACHE_DIR=/data/uploads/.search-cache
SEARCH_CACHE_TTL_SECONDS=604800
FETCH_CACHE_DIR=/data/uploads/.fetch-cache
FETCH_CACHE_TTL_SECONDS=604800
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=3145728
LLM_ANALYSIS_CACHE_DIR=/data/uploads/.llm-analysis-cache
LLM_ANALYSIS_CACHE_TTL_SECONDS=604800
LLM_ANALYSIS_TIMEOUT_SECONDS=90
LLM_ANALYSIS_MAX_INPUT_CHARS=18000
VISUAL_ANALYSIS_CACHE_DIR=/data/uploads/.visual-analysis-cache
VISUAL_ANALYSIS_CACHE_TTL_SECONDS=604800
VISUAL_ANALYSIS_TIMEOUT_SECONDS=90
VISUAL_IMAGE_MAX_BYTES=1048576
VISUAL_IMAGE_MAX_SIDE=1280
MULTIMODAL_ANALYSIS_CACHE_DIR=/data/uploads/.multimodal-analysis-cache
MULTIMODAL_ANALYSIS_CACHE_TTL_SECONDS=604800
MULTIMODAL_ANALYSIS_TIMEOUT_SECONDS=90
MULTIMODAL_ANALYSIS_MAX_INPUT_CHARS=20000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=200
UPLOAD_DIR=/data/uploads
CORS_ALLOWED_ORIGINS=https://projeto-digitacao.netlify.app
